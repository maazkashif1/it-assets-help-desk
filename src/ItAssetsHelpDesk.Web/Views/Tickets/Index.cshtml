@model object
@{
    ViewData["Title"] = "Tickets";
    bool isManager = ViewBag.IsManager;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@(isManager ? "All Tickets" : "My Tickets")</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Ticket</a>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" id="search" class="form-control" placeholder="Search title or description..." />
    </div>
    <div class="col-md-3">
        <select id="statusFilter" class="form-select">
            <option value="">All statuses</option>
            <option value="Open">Open</option>
            <option value="InProgress">In Progress</option>
            <option value="Resolved">Resolved</option>
            <option value="Closed">Closed</option>
        </select>
    </div>
    <div class="col-md-3">
        <select id="priorityFilter" class="form-select">
            <option value="">All priorities</option>
            <option value="Low">Low</option>
            <option value="Medium">Medium</option>
            <option value="High">High</option>
            <option value="Critical">Critical</option>
        </select>
    </div>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Title</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Department</th>
            @if (isManager)
            {
                <th>Assigned To</th>
            }
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="ticketRows">
        <tr><td colspan="7" class="text-center text-muted">Loading...</td></tr>
    </tbody>
</table>

@section Scripts {
<script>
    const isManager = @Json.Serialize(isManager);
    const itStaff = @Html.Raw(ViewBag.ItStaffJson ?? "[]");

    const priorityColor = { Low: 'secondary', Medium: 'info', High: 'warning', Critical: 'danger' };
    const statusColor = { Open: 'danger', InProgress: 'warning', Resolved: 'info', Closed: 'secondary' };

    function badge(value, colorMap) {
        return `<span class="badge bg-${colorMap[value] ?? 'secondary'}">${value}</span>`;
    }

    function statusControl(ticket) {
        if (!isManager) return badge(ticket.status, statusColor);
        const opts = ['Open', 'InProgress', 'Resolved', 'Closed']
            .map(s => `<option value="${s}" ${s === ticket.status ? 'selected' : ''}>${s}</option>`).join('');
        return `<select class="form-select form-select-sm status-select" data-id="${ticket.id}">${opts}</select>`;
    }

    function assigneeControl(ticket) {
        const opts = ['<option value="">Unassigned</option>']
            .concat(itStaff.map(u => `<option value="${u.id}" ${u.id === ticket.assignedToUserId ? 'selected' : ''}>${u.fullName}</option>`))
            .join('');
        return `<select class="form-select form-select-sm assignee-select" data-id="${ticket.id}">${opts}</select>`;
    }

    function renderRows(tickets) {
        if (tickets.length === 0) {
            $('#ticketRows').html(`<tr><td colspan="${isManager ? 7 : 6}" class="text-center text-muted">No tickets found.</td></tr>`);
            return;
        }
        const rows = tickets.map(t => `
            <tr>
                <td><a href="/Tickets/Details/${t.id}">${t.title}</a></td>
                <td>${badge(t.priority, priorityColor)}</td>
                <td>${statusControl(t)}</td>
                <td>${t.departmentName}</td>
                ${isManager ? `<td>${assigneeControl(t)}</td>` : ''}
                <td>${new Date(t.createdAt).toLocaleString('en-US')}</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/Tickets/Details/${t.id}">View</a></td>
            </tr>`).join('');
        $('#ticketRows').html(rows);
    }

    function loadTickets() {
        $.getJSON('/api/tickets', {
            search: $('#search').val(),
            status: $('#statusFilter').val(),
            priority: $('#priorityFilter').val()
        }).done(renderRows);
    }

    $(document).on('change', '.status-select', function () {
        const id = $(this).data('id');
        $.ajax({ url: `/api/tickets/${id}`, method: 'PUT', contentType: 'application/json', data: JSON.stringify({ status: $(this).val() }) })
            .done(loadTickets);
    });

    $(document).on('change', '.assignee-select', function () {
        const id = $(this).data('id');
        $.ajax({ url: `/api/tickets/${id}`, method: 'PUT', contentType: 'application/json', data: JSON.stringify({ assignedToUserId: $(this).val() }) })
            .done(loadTickets);
    });

    let searchTimer;
    $('#search').on('input', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(loadTickets, 250);
    });
    $('#statusFilter, #priorityFilter').on('change', loadTickets);

    $(loadTickets);
</script>
}
