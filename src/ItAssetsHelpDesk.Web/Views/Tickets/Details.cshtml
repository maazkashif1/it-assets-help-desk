@using ItAssetsHelpDesk.Web.Models
@using ItAssetsHelpDesk.Web.Models.Enums
@using Microsoft.AspNetCore.Mvc.Rendering
@model Ticket
@{
    ViewData["Title"] = Model.Title;
    bool isManager = ViewBag.IsManager;
    var itStaffOptions = isManager ? (List<SelectListItem>)ViewBag.ItStaffOptions : new List<SelectListItem>();
}

<h1>@Model.Title</h1>
<p class="text-muted">Submitted by @Model.CreatedByUser?.FullName on @Model.CreatedAt.ToLocalTime().ToString("g")</p>

<dl class="row">
    <dt class="col-sm-2">Description</dt><dd class="col-sm-10">@Model.Description</dd>
    <dt class="col-sm-2">Department</dt><dd class="col-sm-10">@Model.Department?.Name</dd>
    @if (Model.RelatedAsset is not null)
    {
        <dt class="col-sm-2">Related Asset</dt>
        <dd class="col-sm-10"><a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.RelatedAssetId">@Model.RelatedAsset.AssetTag - @Model.RelatedAsset.Name</a></dd>
    }
</dl>

@if (isManager)
{
    <div class="row g-3 mb-3" style="max-width: 640px;">
        <div class="col-md-4">
            <label class="form-label">Priority</label>
            <select id="priority" class="form-select" data-id="@Model.Id">
                @foreach (var p in Enum.GetNames<TicketPriority>())
                {
                    <option value="@p" selected="@(p == Model.Priority.ToString())">@p</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Status</label>
            <select id="status" class="form-select" data-id="@Model.Id">
                @foreach (var s in Enum.GetNames<TicketStatus>())
                {
                    <option value="@s" selected="@(s == Model.Status.ToString())">@s</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Assigned To</label>
            <select id="assignee" asp-items="itStaffOptions" class="form-select" data-id="@Model.Id">
                <option value="">Unassigned</option>
            </select>
        </div>
    </div>
}
else
{
    <p><strong>Priority:</strong> @Model.Priority &nbsp; <strong>Status:</strong> @Model.Status</p>
    <p><strong>Assigned To:</strong> @(Model.AssignedToUser?.FullName ?? "Unassigned")</p>
}

<a asp-action="Index" class="btn btn-secondary">Back to list</a>

@section Scripts {
<script>
    $('#priority, #status, #assignee').on('change', function () {
        const id = $(this).data('id');
        const payload = {};
        payload[this.id === 'assignee' ? 'assignedToUserId' : this.id] = $(this).val();
        $.ajax({ url: `/api/tickets/${id}`, method: 'PUT', contentType: 'application/json', data: JSON.stringify(payload) })
            .done(() => location.reload());
    });
</script>
}
